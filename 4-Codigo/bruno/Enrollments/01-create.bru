meta {
  name: Solicitar inscripción
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/enrollments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "courseId": "{{courseId}}"
  }
}

script:pre-request {
  if (typeof bru.getVar("studentToken") !== "string" || !bru.getVar("studentToken").length) {
    throw new Error("Falta el login requerido: studentToken.");
  }
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  if (!isGuid(bru.getVar("courseId"))) throw new Error("Falta courseId: ejecutar su paso previo en esta misma base.");
  ["enrollmentId", "moduleId", "moduleIds", "progressSnapshot"].forEach(name => bru.deleteVar(name));
}

script:post-response {
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  const body = res.getBody();
  if (res.getStatus() !== 201 || !body || !isGuid(body.id) || body.status !== "Pendiente" ||
      body.courseId !== bru.getVar("courseId") || body.studentId !== bru.getVar("studentUserId")) {
    throw new Error("No se capturó la solicitud pendiente del alumno y curso actuales.");
  }
  bru.setVar("enrollmentId", body.id);
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  const body = res.getBody();
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  test("Inscripción del alumno y curso seleccionados", function () {
    expect(isGuid(body.id)).to.equal(true);
    expect(body.id).to.equal(bru.getVar("enrollmentId"));
    expect(body.courseId).to.equal(bru.getVar("courseId"));
    expect(body.studentId).to.equal(bru.getVar("studentUserId"));
    expect(body.status).to.equal("Pendiente");
    expect(body.resolvedAtUtc).to.equal(null);
  });
}
