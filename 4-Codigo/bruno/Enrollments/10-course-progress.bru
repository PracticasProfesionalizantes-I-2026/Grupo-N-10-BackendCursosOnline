meta {
  name: Progreso de alumnos
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/courses/{{courseId}}/students/progress
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

script:pre-request {
  if (typeof bru.getVar("teacherToken") !== "string" || !bru.getVar("teacherToken").length) {
    throw new Error("Falta el login requerido: teacherToken.");
  }
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  if (!isGuid(bru.getVar("courseId"))) throw new Error("Falta courseId: ejecutar su paso previo en esta misma base.");
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  const body = res.getBody();
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  test("Listado válido sin exigir datos ajenos al escenario", function () {
    expect(Array.isArray(body)).to.equal(true);
    expect(body.every(row => isGuid(row.studentId) && row.progress && row.progress.courseId === bru.getVar("courseId"))).to.equal(true);
    expect(new Set(body.map(row => row.progress.enrollmentId)).size).to.equal(body.length);
  });
}
