meta {
  name: Login Alumno
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "alumno@lumen.local",
    "password": "Lumen123!"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body && typeof body.accessToken === "string" && body.accessToken.length > 0) {
    bru.setVar("studentToken", body.accessToken);
  } else {
    bru.deleteVar("studentToken");
    throw new Error("Login de Alumno fallido: no se conservó ningún token runtime.");
  }
}
