meta {
  name: Login Profesor
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "profesor@lumen.local",
    "password": "Lumen123!"
  }
}

script:pre-request {
  bru.deleteVar("teacherToken");
  bru.deleteVar("teacherUserId");
}

script:post-response {
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  const body = res.getBody();
  if (res.getStatus() !== 200 || !body || typeof body.accessToken !== "string" || !body.accessToken.length ||
      !body.user || !isGuid(body.user.id) || body.user.role !== "Profesor") {
    bru.deleteVar("teacherToken");
    throw new Error("Login de Profesor inválido: no se conserva un token anterior.");
  }
  bru.setVar("teacherToken", body.accessToken);
  bru.setVar("teacherUserId", body.user.id);
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  const body = res.getBody();
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  test("Token runtime e identidad del rol autenticado", function () {
    expect(typeof body.accessToken === "string" && body.accessToken.length > 0).to.equal(true);
    expect(isGuid(body.user.id)).to.equal(true);
    expect(body.user.role).to.equal("Profesor");
    expect(Number.isNaN(Date.parse(body.expiresAtUtc))).to.equal(false);
  });
}
