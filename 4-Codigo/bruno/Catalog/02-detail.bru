meta {
  name: Detalle publicado
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/catalog/courses/{{courseId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

script:pre-request {
  if (typeof bru.getVar("studentToken") !== "string" || !bru.getVar("studentToken").length) {
    throw new Error("Falta el login requerido: studentToken.");
  }
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  if (!isGuid(bru.getVar("courseId"))) throw new Error("Falta courseId: ejecutar su paso previo en esta misma base.");
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  const body = res.getBody();
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  test("Catálogo publicado sin contenido reservado", function () {
    expect(body.id).to.equal(bru.getVar("courseId"));
    expect(body.version > 0).to.equal(true);
    expect(Array.isArray(body.modules)).to.equal(true);
    expect(body.modules.every(module => isGuid(module.id) && module.content === null && Array.isArray(module.resources) && module.resources.length === 0)).to.equal(true);
  });
}
