meta {
  name: CU-02 - Login Alumno
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "alumno@lumen.local",
    "password": "Lumen123!"
  }
}

script:pre-request {
  bru.deleteVar("studentToken");
  bru.deleteVar("studentUserId");
}

script:post-response {
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  const body = res.getBody();
  if (res.getStatus() !== 200 || !body || typeof body.accessToken !== "string" || !body.accessToken.length ||
      !body.user || !isGuid(body.user.id) || body.user.role !== "Alumno") {
    bru.deleteVar("studentToken");
    throw new Error("Login de Alumno inválido: no se conserva un token anterior.");
  }
  bru.setVar("studentToken", body.accessToken);
  bru.setVar("studentUserId", body.user.id);
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  const body = res.getBody();
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  test("Token runtime e identidad del rol autenticado", function () {
    expect(typeof body.accessToken === "string" && body.accessToken.length > 0).to.equal(true);
    expect(isGuid(body.user.id)).to.equal(true);
    expect(body.user.role).to.equal("Alumno");
    expect(Number.isNaN(Date.parse(body.expiresAtUtc))).to.equal(false);
  });
}

docs {
  Paso 1 de 19. Ejecutar esta carpeta en orden, únicamente contra la API temporal; ver README.md.
}
