meta {
  name: CU-03 - Enviar a revisión
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/courses/{{courseId}}/submit-review
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

script:pre-request {
  if (typeof bru.getVar("teacherToken") !== "string" || !bru.getVar("teacherToken").length) {
    throw new Error("Falta el login requerido: teacherToken.");
  }
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  if (!isGuid(bru.getVar("courseId"))) throw new Error("Falta courseId: ejecutar su paso previo en esta misma base.");
  bru.deleteVar("reviewId");
  bru.deleteVar("reviewRevisionId");
}

script:post-response {
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  const body = res.getBody();
  if (res.getStatus() !== 200 || !body || !isGuid(body.id) || !isGuid(body.revisionId) ||
      body.id === body.revisionId || body.courseId !== bru.getVar("courseId") || body.decision !== null) {
    throw new Error("No se capturó una auditoría pendiente del curso actual.");
  }
  bru.setVar("reviewId", body.id);
  bru.setVar("reviewRevisionId", body.revisionId);
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  const body = res.getBody();
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  test("Auditoría pendiente: reviewId es id, no revisionId", function () {
    expect(body.id).to.equal(bru.getVar("reviewId"));
    expect(body.revisionId).to.equal(bru.getVar("reviewRevisionId"));
    expect(body.id).not.to.equal(body.revisionId);
    expect(body.courseId).to.equal(bru.getVar("courseId"));
    expect(body.decision).to.equal(null);
  });
}

docs {
  Paso 5 de 19. Ejecutar esta carpeta en orden, únicamente contra la API temporal; ver README.md.
}
