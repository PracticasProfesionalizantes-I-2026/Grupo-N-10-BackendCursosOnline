meta {
  name: Rechazar pendiente en pausa
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/enrollments/{{policyEnrollmentCId}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {"decision": "Rechazada"}
}

tests {
  test('HTTP 200 y contrato', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal('Rechazada');
  });
}
