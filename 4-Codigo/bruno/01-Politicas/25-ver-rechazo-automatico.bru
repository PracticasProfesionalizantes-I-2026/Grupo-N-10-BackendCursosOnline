meta {
  name: Ver rechazo automatico
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/enrollments/{{policyEnrollmentCId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test('HTTP 200 y contrato', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal('Rechazada'); expect(res.getBody().resolutionReason).to.equal('Curso finalizado.');
  });
}
