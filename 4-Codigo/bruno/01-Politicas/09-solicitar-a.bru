meta {
  name: Solicitar A
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/enrollments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{studentAToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {"courseId": "{{policyCourseId}}"}
}

script:post-response {
  bru.setVar('policyEnrollmentAId', res.getBody().id);
}

tests {
  test('HTTP 201 y contrato', function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal('Pendiente');
  });
}
