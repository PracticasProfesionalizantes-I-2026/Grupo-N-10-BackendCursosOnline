meta {
  name: Cupo completo
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/enrollments/{{policyEnrollmentBId}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {"decision": "Aprobada"}
}

tests {
  test('HTTP 409 y contrato', function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal('EnrollmentStateConflictException');
  });
}
