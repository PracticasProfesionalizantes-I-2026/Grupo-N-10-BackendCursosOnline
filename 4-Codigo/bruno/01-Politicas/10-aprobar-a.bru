meta {
  name: Aprobar A
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/enrollments/{{policyEnrollmentAId}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {"decision": "Aprobada"}
}

tests {
  test('HTTP 200 y contrato', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal('Aprobada');
  });
}
