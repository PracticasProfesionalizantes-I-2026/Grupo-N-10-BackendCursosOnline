}

body:json {
  {"email": "politica-invalido@example.test", "password": "Lumen123!", "role": "Alumno", "firstName": "Alumno", "lastName": "Prueba", "dni": "123456", "phone": "11-1234-5678", "address": "Calle 1", "postalCode": "C1000ABC"}
}

tests {
  test('HTTP 400 y contrato', function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal('LumenValidationException');
  });
