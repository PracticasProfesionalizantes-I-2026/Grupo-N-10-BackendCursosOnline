meta {
  name: Consultar usuario
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/users/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  if (typeof bru.getVar("adminToken") !== "string" || !bru.getVar("adminToken").length) {
    throw new Error("Falta el login requerido: adminToken.");
  }
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  if (!isGuid(bru.getVar("userId"))) throw new Error("Falta userId: ejecutar su paso previo en esta misma base.");
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  const body = res.getBody();
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  test("Usuario sin contraseña ni hash en la respuesta", function () {
    expect(isGuid(body.id)).to.equal(true);
    expect(typeof body.email).to.equal("string");
    expect(Object.prototype.hasOwnProperty.call(body, "passwordHash")).to.equal(false);
    expect(Object.prototype.hasOwnProperty.call(body, "password")).to.equal(false);
    expect(body.id).to.equal(bru.getVar("userId"));
  });
}
