meta {
  name: Crear administrador
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/users/administrators
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin2@lumen.local",
    "password": "Lumen123!",
    "firstName": "Segundo",
    "lastName": "Admin",
    "dni": "25111222",
    "phone": "11-3333-2222",
    "address": "Calle 20",
    "postalCode": "1000"
  }
}

script:pre-request {
  if (typeof bru.getVar("adminToken") !== "string" || !bru.getVar("adminToken").length) {
    throw new Error("Falta el login requerido: adminToken.");
  }
}

script:post-response {
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  const body = res.getBody();
  if (res.getStatus() !== 201 || !body || !isGuid(body.id) || body.role !== "Administrador") {
    throw new Error("No se creó la cuenta administrativa.");
  }
  bru.setVar("createdAdminUserId", body.id);
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  const body = res.getBody();
  const isGuid = value => typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value) && value !== "00000000-0000-0000-0000-000000000000";
  test("Usuario sin contraseña ni hash en la respuesta", function () {
    expect(isGuid(body.id)).to.equal(true);
    expect(typeof body.email).to.equal("string");
    expect(Object.prototype.hasOwnProperty.call(body, "passwordHash")).to.equal(false);
    expect(Object.prototype.hasOwnProperty.call(body, "password")).to.equal(false);
    expect(body.role).to.equal("Administrador");
  });
}
