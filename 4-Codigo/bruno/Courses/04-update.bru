    "maxCapacity": 25,
    "learningObjectives": ["Aplicar fundamentos"],
    "suggestedPrerequisites": ["Conocimientos básicos"],
    "modules": [
      {
        "id": null,
        "name": "Módulo actualizado",
        "description": "Contenido actualizado",
        "durationMinutes": 90,
        "content": "Material reservado",
        "resources": ["material.pdf"]
      }
    ]
  }
}
