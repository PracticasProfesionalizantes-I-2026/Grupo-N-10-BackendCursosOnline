meta { name: Actualizar curso type: http seq: 4 }
put { url: {{baseUrl}}/api/courses/{{courseId}} body: json auth: bearer }
auth:bearer { token: {{teacherToken}} }
body:json {
  {
    "title": "Curso actualizado",
