meta {
  name: Reporte resumido
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/reports/summary?from=2000-01-01&to=2099-12-31
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  if (typeof bru.getVar("adminToken") !== "string" || !bru.getVar("adminToken").length) {
    throw new Error("Falta el login requerido: adminToken.");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  const body = res.getBody();
  test("El período exacto incluye al menos los registros de la semilla demo", function () {
    expect(new Date(body.from).toISOString().slice(0, 10)).to.equal("2000-01-01");
    expect(new Date(body.to).toISOString().slice(0, 10)).to.equal("2099-12-31");
    ["registeredUsers", "createdCourses", "requestedEnrollments"].forEach(field => {
      expect(Number.isInteger(body[field]) && body[field] >= 0).to.equal(true);
    });
    expect(body.registeredUsers).to.be.at.least(3);
    expect(body.createdCourses).to.be.at.least(2);
    expect(body.requestedEnrollments).to.be.at.least(2);
  });
}
